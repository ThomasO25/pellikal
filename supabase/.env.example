# ============================================================================
#  PELLIKAL - Edge Function secrets for sync-google-reviews  (EXAMPLE ONLY)
#
#  Copy to supabase/.env (which is git-ignored - never commit it) and fill in
#  real values, then push them to the project with:
#      supabase secrets set --env-file supabase/.env
#  Or paste each one in Dashboard -> Edge Functions -> Secrets.
#
#  NONE of these ever goes into js/config.js, any page, or any file the
#  browser can load. The website only ever holds the public anon key.
#  Full walkthrough: docs/GOOGLE-REVIEWS.md -> GOOGLE BUSINESS PROFILE SETUP REQUIRED
# ============================================================================

# OAuth 2.0 client (Google Cloud -> APIs & Services -> Credentials -> "Web application")
GOOGLE_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz012345.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-replace-with-your-client-secret

# Refresh token for the Google account that MANAGES the Pellikal Business Profile
# (obtained once via the OAuth 2.0 Playground - step 7 of the setup guide)
GOOGLE_REFRESH_TOKEN=1//0replace-with-your-refresh-token

# Numeric IDs only - NOT "accounts/..." or "locations/..."
# (find them with:  GET https://<project>.supabase.co/functions/v1/sync-google-reviews?discover=1  + the x-sync-secret header)
GOOGLE_BUSINESS_ACCOUNT_ID=1234567890
GOOGLE_BUSINESS_LOCATION_ID=9876543210

# Shared secret that protects the function (any random string, 32+ characters).
# Generate one with:  openssl rand -hex 32
# The SAME value goes into supabase/sql/schedule_google_reviews_sync.sql (<SYNC_SECRET>).
SYNC_SECRET=replace-with-a-long-random-string-at-least-32-chars

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to the function
# automatically by Supabase. Do not set them here, and never copy the
# service_role key anywhere else.
